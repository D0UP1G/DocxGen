{
  "name": "@docxgen/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/document-service.js",
    "start": "node --env-file-if-exists=../../.env src/document-service.js",
    "start:doc-service": "node --env-file-if-exists=../../.env src/document-service.js",
    "start:audio-service": "node --env-file-if-exists=../../.env src/audio-service.js",
    "setup:audio": "bash scripts/setup-audio.sh",
    "start:max-bot": "node --env-file-if-exists=../../.env src/max-bot-service.js",
    "start:vk-bot": "node --env-file-if-exists=../../.env src/vk-bot-service.js",
    "start:local-bot": "node --env-file-if-exists=../../.env src/local-bot-service.js",
    "start:services": "node --env-file-if-exists=../../.env -e \"const { exec } = require('child_process'); exec('node src/document-service.js'); exec('node src/audio-service.js'); exec('node src/max-bot-service.js'); exec('node src/vk-bot-service.js'); exec('node src/local-bot-service.js');\"",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=../../.env scripts/eval.js",
    "opencode:check": "node --env-file-if-exists=../../.env scripts/opencode-check.js",
    "opencode:build": "docker build -t doc3steps-opencode opencode",
    "max:subscribe": "node --env-file-if-exists=../../.env scripts/max-subscribe.js",
    "max:poll": "node --env-file-if-exists=../../.env scripts/max-poll.js",
    "vk:poll": "node --env-file-if-exists=../../.env scripts/vk-poll.js"
  },
  "dependencies": {
    "better-sqlite3": "^12",
    "cookie-parser": "^1",
    "docx": "^9",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^4",
    "vk-io": "^4"
  },
  "devDependencies": {
    "jszip": "^3",
    "supertest": "^7",
    "vitest": "^3"
  }
}
