{
  "name": "docxgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green \"node --env-file-if-exists=.env --watch src/server.js\" \"pnpm --filter @docxgen/frontend dev\"",
    "dev:frontend": "pnpm --filter @docxgen/frontend dev",
    "dev:backend": "node --env-file-if-exists=.env --watch src/server.js",
    "dev:legacy": "pnpm --filter @docxgen/backend dev",
    "start": "node src/server.js",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=.env scripts/eval.js",
    "demo": "node --env-file-if-exists=.env scripts/make-demo.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "better-sqlite3": "^12",
    "cookie-parser": "^1",
    "docx": "^9",
    "express": "^5",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jszip": "^3",
    "supertest": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
