{
  "name": "docxgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,web --prefix-colors blue,red \"pnpm --filter @docxgen/backend start\" \"pnpm --filter @docxgen/frontend dev\"",
    "start": "pnpm --filter @docxgen/backend start",
    "test": "pnpm --filter @docxgen/backend test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "eval": "pnpm --filter @docxgen/backend eval",
    "opencode:check": "pnpm --filter @docxgen/backend opencode:check",
    "max:subscribe": "pnpm --filter @docxgen/backend max:subscribe"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
