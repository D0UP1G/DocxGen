{
  "name": "docxgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,frontend --prefix-colors blue,green \"pnpm --filter @docxgen/backend dev\" \"pnpm --filter @docxgen/frontend dev\"",
    "dev:frontend": "pnpm --filter @docxgen/frontend dev",
    "dev:backend": "pnpm --filter @docxgen/backend dev",
    "start": "pnpm --filter @docxgen/backend start",
    "test": "pnpm --filter @docxgen/backend test",
    "eval": "pnpm --filter @docxgen/backend eval",
    "demo": "pnpm --filter @docxgen/backend demo",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
